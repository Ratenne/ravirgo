---
import '../../styles/home.css';
import Brand from '../../components/Brand.astro';
import Arrow from '../../components/Arrow.astro';
import {services} from '../../data/services';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}));}
const {service:s}=Astro.props;
const url=`https://ravirgo.com/services/${s.slug}/`;
const schema={'@context':'https://schema.org','@type':'WebPage',name:`${s.name} | RAVIRGO`,url,description:s.description,mainEntity:{'@type':'WebApplication',name:s.name,url:s.url,applicationCategory:s.categoryLabel,description:s.description}};
---
<!doctype html><html lang="ko"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{s.name} 소개 | RAVIRGO</title><meta name="description" content={s.description}/><link rel="canonical" href={url}/><meta name="robots" content="index,follow,max-image-preview:large"/><meta property="og:type" content="website"/><meta property="og:locale" content="ko_KR"/><meta property="og:site_name" content="RAVIRGO"/><meta property="og:title" content={`${s.name} 소개 | RAVIRGO`}/><meta property="og:description" content={s.description}/><meta property="og:url" content={url}/><meta property="og:image" content="https://ravirgo.com/assets/orbital-poster.webp"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={`${s.name} 소개 | RAVIRGO`}/><meta name="twitter:description" content={s.description}/><meta name="twitter:image" content="https://ravirgo.com/assets/orbital-poster.webp"/><meta name="theme-color" content="#08121e"/><link rel="icon" href="/assets/brand/ravirgo-symbol.webp"/><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/></head><body><a class="skip-link" href="#main">본문으로 이동</a><header class="site-header"><Brand/><nav aria-label="메인 메뉴"><a href="/#services">서비스</a><a href="/about">RAVIRGO 소개</a></nav></header><main class="detail-main" id="main"><nav class="breadcrumb" aria-label="현재 위치"><a href="/#services">전체 서비스</a><span aria-hidden="true">/</span><span>{s.categoryLabel}</span></nav><h1>{s.name}</h1><p>{s.description}</p><a class="launch-link" href={s.url}>{s.name} 열기 <Arrow/></a><a class="service-domain" href={s.url}>{new URL(s.url).hostname}</a><h2>서비스 안내</h2>{s.slug==='pricepulse'?<><p>GPU, CPU, 노트북의 가격 변화를 살펴보고 현재 가격의 위치를 확인하는 서비스입니다.</p><ul><li>상품군별 가격 흐름 확인</li><li>기간별 가격 변화와 가격 범위 비교</li></ul><p>서비스에 표시된 예시 가격은 해당 화면의 안내를 확인하세요.</p></>:<><p>영수증의 문자를 읽어 엑셀로 정리하는 서비스입니다.</p><ul><li>영수증 정보 읽기</li><li>엑셀로 정보 정리</li></ul></>}<a class="back-link" href="/#services">전체 서비스로 돌아가기</a></main><footer class="site-footer"><Brand/><nav aria-label="하단 메뉴"><a href="/#services">서비스</a><a href="/about">RAVIRGO 소개</a></nav><small>© {new Date().getFullYear()} RAVIRGO</small></footer></body></html>
